							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is equal to the request\", function () {",
							"    const reqBody = pm.request.body.raw ? JSON.parse(pm.request.body.raw) : {};",
							"    const resBody = pm.response.json();",
							"",
							"    pm.expect(resBody.data.photoFilename).to.eql(reqBody.photoFilename);",
							"    pm.expect(resBody.data.name).to.eql(reqBody.name);",
							"    pm.expect(resBody.data.lastName).to.eql(reqBody.lastName);",
							"    pm.expect(resBody.data.country).to.eql(reqBody.country);",
							"    ",
							"    const reqDate = new Date(reqBody.dateBirth);",
							"    const resDate = new Date(resBody.data.dateBirth);",
							"",
							"    pm.expect(resDate.getFullYear()).to.eql(reqDate.getFullYear());",
							"    pm.expect(resDate.getMonth()).to.eql(reqDate.getMonth());",
							"    pm.expect(resDate.getDate()).to.eql(reqDate.getDate());",
