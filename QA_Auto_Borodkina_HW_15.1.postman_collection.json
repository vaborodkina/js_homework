		{
			"name": "Negative tests",
			"item": [
				{
					"name": "NAME VALIDATION",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const email = (Math.random() * 10000000).toFixed(0) + '@test.com'\r",
									"const newPwd = \"{{newPwd}}\"\r",
									"const name = \"{{name}}\"\r",
									"pm.collectionVariables.set('email', email)\r",
									"pm.collectionVariables.set('newPwd', newPwd)\r",
									"\r",
									"const data = [\r",
									"{\r",
									"    testCaseName: \"Empty user name\",\r",
									"    testData: \"\",\r",
									"    expectedResult: {\r",
									"    status: \"error\",\r",
									"    message: \"\\\"name\\\" is not allowed to be empty\"\r",
									"    }\r",
									"},\r",
									"{\r",
									"    testCaseName: \"Invalid user name (cyrillic)\",\r",
									"    testData: \"Алан\",\r",
									"    expectedResult: {\r",
									"    status: \"error\",\r",
									"    message: \"Name is invalid\"\r",
									"    }\r",
									"},\r",
									"{\r",
									"    testCaseName: \"Short user name\",\r",
									"    testData: \"A\",\r",
									"    expectedResult: {\r",
									"    status: \"error\",\r",
									"    message: \"Name has to be from 2 to 20 characters long\"\r",
									"    }\r",
									"},\r",
									"]\r",
									"\r",
									"let currentIter = parseInt(pm.collectionVariables.get(\"currentIter\")) || 0;\r",
									"\r",
									"if (currentIter >= data.length) {\r",
									"    pm.execution.setNextRequest(null);\r",
									"    return;\r",
									"}\r",
									"\r",
									"pm.collectionVariables.set(\"name\", data[currentIter].testData);\r",
									"pm.collectionVariables.set(\"expectedResult\", JSON.stringify(data[currentIter].expectedResult));\r",
									"pm.collectionVariables.set(\"length\", data.length); \r",
									"\r",
									"\r",
									"\r",
									"\r",
									"\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();\r",
									"\r",
									"let currentIter = parseInt(pm.collectionVariables.get(\"currentIter\") || 0);\r",
									"let length = parseInt(pm.collectionVariables.get(\"length\"));\r",
									"let expected = JSON.parse(pm.collectionVariables.get(\"expectedResult\"));\r",
									"\r",
									"pm.test(\"Create a new user with invalid data\", function () {\r",
									"        pm.expect(jsonData.status).to.eql(expected.status);\r",
									"        pm.expect(jsonData.message).to.eql(expected.message);\r",
									"});\r",
									"    pm.collectionVariables.set(\"currentIter\", currentIter + 1);\r",
									"    if (pm.collectionVariables.get(\"currentIter\") < pm.collectionVariables.get(\"length\")) {\r",
									"        pm.execution.setNextRequest(pm.info.requestName);\r",
									"} else{\r",
									"        pm.collectionVariables.set(\"currentIter\", 0);\r",
									"        pm.execution.setNextRequest(\"Invalid email\");\r",
									" \r",
									"}\r",
									"\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
